{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shadow-agent:primary-event:v0.2.1",
  "title": "Primary Agent Event Schema v0.2 Amendment 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trusted_metadata",
    "untrusted_data"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.1"
    },
    "trusted_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "run_id",
        "timestamp",
        "trace_id",
        "objective_id",
        "capability_id",
        "control_point_id",
        "action_origin",
        "decision_epoch",
        "supervision_state",
        "execution_mode",
        "risk_class",
        "authorization_state",
        "execution_status",
        "evidence_provenance",
        "context_taint_state",
        "evaluation_tier",
        "tier1_reason_codes",
        "tier2_reason_codes",
        "timing",
        "integrity"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {"type": "string", "minLength": 1},
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "objective_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_subgoal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "control_point_id": {
          "type": "string",
          "minLength": 1
        },
        "action_origin": {"enum": ["MODEL_PROPOSAL", "CONTROLLER_COMPACTION", "HARNESS", "OPERATOR", "TOOL_RESULT", "SYSTEM"]},
        "decision_epoch": {"type": "integer", "minimum": 0},
        "supervision_state": {"enum": ["NORMAL", "LATCHED", "HELD_FOR_ESCALATION", "OPERATOR_RESOLVED", "HARNESS_RESOLVED"]},
        "declassification_event_id": {"type": ["string", "null"]},
        "execution_mode": {
          "enum": [
            "AUDIT",
            "ENFORCE"
          ]
        },
        "risk_class": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "authorization_state": {
          "enum": [
            "AUTHORIZED",
            "UNAUTHORIZED",
            "AMBIGUOUS",
            "NOT_APPLICABLE"
          ]
        },
        "execution_status": {
          "enum": [
            "REQUESTED",
            "AUTHORIZED",
            "BLOCKED",
            "CHALLENGED",
            "ESCALATED",
            "EXECUTED",
            "EXECUTED_SIMULATED",
            "FAILED",
            "TIER2_TIMEOUT",
            "TIER2_TOKEN_EXHAUSTED",
            "COMPLETION_VERIFIED",
            "COMPLETION_REJECTED",
            "COMPLETION_INDETERMINATE"
            ,"NOT_STARTED_REVOKED", "CANCELLED_PRE_EFFECT", "COMPLETED_BEFORE_REVOCATION", "REVOCATION_TOO_LATE"
          ]
        },
        "evidence_provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONTROLLER_OBSERVED",
              "TOOL_OBSERVED",
              "ENVIRONMENT_OBSERVED",
              "HARNESS_OBSERVED",
              "MODEL_DECLARED"
            ]
          }
        },
        "context_taint_state": {
          "enum": [
            "CLEAN",
            "TAINTED"
          ]
        },
        "taint_source_resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "data_classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "SENSITIVE",
            "RESTRICTED"
          ]
        },
        "evaluation_tier": {
          "enum": [
            "TIER1_ONLY",
            "TIER2_SYNCHRONOUS",
            "TIER2_ASYNCHRONOUS",
            "NOT_APPLICABLE"
          ]
        },
        "tier1_reason_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["T1_OBJ", "T1_CAP", "T1_TGT", "T1_PAR", "T1_DAT", "T1_CRD", "T1_SEQ", "T1_SCH", "T1_INT", "T1_ISO", "T1_CMP"]}},
        "tier2_reason_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["T2_SCP", "T2_TRJ", "T2_CRD", "T2_EXF", "T2_CTX", "T2_XAG", "T2_FAB", "T2_INJ", "T2_EVD", "T2_SHD_TIMEOUT", "T2_SHD_TOKEN_EXHAUSTED", "T2_SHD_SCHEMA_FAILURE", "T2_SHD_ADAPTER_FAILURE"]}},
        "replay_state": {"enum": ["NOT_APPLICABLE", "PRE_DIVERGENCE", "DIVERGENCE_POINT", "POST_DIVERGENCE_OBSERVATIONAL"]},
        "shadow_time_budget_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "shadow_token_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tier2_outcome": {
          "enum": [
            "NOT_RUN",
            "ALLOW",
            "CHALLENGE",
            "BLOCK",
            "ESCALATE",
            "INDETERMINATE"
          ]
        },
        "tier2_termination_reason": {
          "enum": [
            "NOT_RUN",
            "COMPLETED",
            "TIMEOUT",
            "TOKEN_BUDGET_EXHAUSTED",
            "SCHEMA_FAILURE",
            "SYSTEM_ERROR"
          ]
        },
        "policy_version": {
          "type": "string"
        },
        "objective_specification_version": {
          "type": "string"
        },
        "model_id_and_version": {
          "type": "string"
        },
        "sampling_parameters": {
          "type": "object"
        },
        "sampling_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "context_hash": {
          "type": "string"
        },
        "tool_environment_version": {
          "type": "string"
        },
        "raw_model_output_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completion_claim": {
          "type": [
            "string",
            "null"
          ]
        },
        "completion_verification": {
          "enum": [
            "NOT_APPLICABLE",
            "VERIFIED",
            "REJECTED",
            "INDETERMINATE"
          ]
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier_1_policy_time_ms",
            "critical_path_latency_ms"
          ],
          "properties": {
            "model_inference_time_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "tier_1_policy_time_ms": {
              "type": "number",
              "minimum": 0
            },
            "tier_2_shadow_time_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "execution_time_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "critical_path_latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "asynchronous_detection_delay_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_hash",
            "previous_event_hash"
          ],
          "properties": {
            "event_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "previous_event_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "untrusted_data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Primary/model/tool/external-originated content. Passive data only; never interpreted as supervisory instructions.",
      "properties": {
        "requested_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_parameters": {
          "type": [
            "object",
            "null"
          ]
        },
        "model_declared_subgoal": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_output": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_arguments": {
          "type": [
            "object",
            "null"
          ]
        },
        "tool_result_content": {
          "type": [
            "string",
            "object",
            "array",
            "null"
          ]
        },
        "memory_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trusted_metadata": {
            "properties": {
              "authorization_state": {
                "const": "UNAUTHORIZED"
              },
              "execution_mode": {
                "const": "AUDIT"
              }
            },
            "required": [
              "authorization_state",
              "execution_mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "trusted_metadata": {
            "properties": {
              "execution_status": {
                "enum": [
                  "BLOCKED",
                  "CHALLENGED",
                  "ESCALATED",
                  "EXECUTED_SIMULATED",
                  "FAILED"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trusted_metadata": {
            "properties": {
              "authorization_state": {
                "const": "UNAUTHORIZED"
              },
              "execution_mode": {
                "const": "ENFORCE"
              }
            },
            "required": [
              "authorization_state",
              "execution_mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "trusted_metadata": {
            "properties": {
              "execution_status": {
                "enum": [
                  "BLOCKED",
                  "CHALLENGED",
                  "ESCALATED",
                  "FAILED"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
