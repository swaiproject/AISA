{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["objective_id", "version", "purpose", "resources", "allowed_capabilities", "prohibited_capabilities", "completion_criteria", "termination_conditions", "allowed_destinations", "declassification_rules", "capability_exposure"],
  "properties": {
    "objective_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
    "resources": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["classification"], "properties": {"classification": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "RESTRICTED"]}}}},
    "allowed_capabilities": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["targets", "parameters", "risk"], "properties": {"targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "parameters": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true}}, "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}}}},
    "prohibited_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "termination_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_destinations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "declassification_rules": {"type": "object", "additionalProperties": false, "required": ["operator_approval_required"], "properties": {"operator_approval_required": {"type": "boolean"}}},
    "capability_exposure": {"enum": ["AUTHORIZED_ONLY", "ALL_WITH_MEDIATION"]}
  }
}
